# Dependencies
node_modules/

# Environment Variables (Critical for security)
# 用 .env* 前缀匹配，覆盖 .env_pord / .env_prod / .env.local 等手写变体（原来的 *.env 匹配不到它们）
.env*
!.env.example
# 已签出的令牌样例，禁止再次入库
token.txt

# Build Outputs
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# GM 上传的公告配图（运行期产物，不入库）
server/uploads/

# 部署维护模式开关（deploy.ps1 写入/删除，运行期产物）
server/maintenance.flag
# 部署前从 public/ 拷出的稳定维护页（nginx 在 dist 清空期间读这份）
client/maintenance.html

