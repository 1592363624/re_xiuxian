  "gazetteer": [
    {
      "id": "gz_yueguo_market",
      "poi_id": "yueguo_market",
      "region_id": "yueguo",
      "title": "越国坊市",
      "text": "凡人也做修士的生意，只是摊上摆的是干柴与草药。清晨的雾从河面爬上来，裹住秤杆与讨价还价的声音。偶有修士驻足，买一壶浊酒，问一句山路是否好走。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "凡人与修士的交界"
    },
    {
      "id": "gz_qixuanmen",
      "poi_id": "qixuanmen",
      "region_id": "yueguo",
      "title": "七玄门",
      "text": "山门不大，石阶却磨得发亮——来来去去都是想摸到仙缘的人。殿前的老松歪着身子，像听了太多誓言。夜里偶有剑鸣，不知是风，还是谁在试招。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "小门派的仙缘入口"
    },
    {
      "id": "gz_caixia_trail",
      "poi_id": "caixia_trail",
      "region_id": "yueguo",
      "title": "彩霞山径",
      "text": "霞光落在山脊上像一层薄金。采药人说那是地脉在呼吸；修士说那是灵气在换气。山径窄处只容一人，走快了会踢落石子，惊起一整坡的鸟。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "地脉与霞光"
    },
    {
      "id": "gz_abandoned_mine",
      "poi_id": "abandoned_mine",
      "region_id": "yueguo",
      "title": "废弃矿洞",
      "text": "矿脉早空了，洞口的木架还在，风一过就吱呀作响。有人在壁上刻了又擦的记号，像在找什么，又像在藏什么。深处偶有金石轻响，不知是落石，还是别的什么在敲。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "被掏空的矿脉"
    },
    {
      "id": "gz_wolf_nest",
      "poi_id": "wolf_nest",
      "region_id": "yueguo",
      "title": "狼谷",
      "text": "夜里能听见狼嚎顺着谷口滚下来。牧人绕着走，猎人也绕着走。只有修士会踩进去——为了兽核，也为了证明自己已经不是会被狼群追着跑的人。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "野兽与修行者"
    },
    {
      "id": "gz_cangkun_gate",
      "poi_id": "cangkun_gate",
      "region_id": "yueguo",
      "title": "苍坤旧禁",
      "text": "禁制残纹像干涸的河床。进去的人说，里面的墙会自己改路；出来的人说，最好别记路，记了也对不上。石门上的名字被风雨磨平，只余一个「禁」字仍锋利。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "会改路的旧禁",
      "related_dungeon": "cangkun"
    },
    {
      "id": "gz_to_luanxing",
      "poi_id": "to_luanxing",
      "region_id": "yueguo",
      "title": "渡口",
      "text": "船家不问来历，只问你带没带够灵石。跳板湿滑，缆绳勒进木桩。对岸的雾比这边厚，据说雾里有岛，岛上有祭坛，祭坛下压着谁都不肯说的东西。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "通往乱星海"
    },
    {
      "id": "gz_haigang",
      "poi_id": "haigang",
      "region_id": "luanxing_sea",
      "title": "海港坊市",
      "text": "盐雾里混着丹香。这里的价格随潮水涨落：潮起时稀货多，潮落时人心急。码头上堆着未卸完的海藻箱，箱角压着半张不知谁丢的残图。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "潮汐与价格"
    },
    {
      "id": "gz_xinghai_altar",
      "poi_id": "xinghai_altar",
      "region_id": "luanxing_sea",
      "title": "星祭坛",
      "text": "潮退时露出的石阶直指海底。祭坛上的凹槽像曾经放过什么东西——也许是灯，也许是鼎，也许是某个人的名姓。夜里仰头，星子落进浪里，分不清是谁在祭谁。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "海底祭坛"
    },
    {
      "id": "gz_anxiao_gate",
      "poi_id": "anxiao_gate",
      "region_id": "luanxing_sea",
      "title": "暗礁禁门",
      "text": "船队绕着这片礁走。绕不过去的，就再也没回来。礁缝里偶尔浮出半截断桅，桅杆上的结还在，系船的人不见了。禁门之后是否另有天地，只有胆子最大的探海人敢猜。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "回不来的船"
    },
    {
      "id": "gz_dayan_gate",
      "poi_id": "dayan_gate",
      "region_id": "dayan_hall",
      "title": "大衍神殿",
      "text": "殿中无像，只有无数转不停的铜环——像一门还在演算的功法。环影落在墙上，层层叠叠。有人在此枯坐数年，出关时只说了一句：算不尽。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "仍在演算的传承"
    },
    {
      "id": "gz_kuilei_forge",
      "poi_id": "kuilei_forge",
      "region_id": "dayan_hall",
      "title": "傀儡坊",
      "text": "炉火不灭。卖的不是傀儡，是「再走一程」的底气。匠人不多话，只在交货时提醒一句：它替你挡的，终归要有人还。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "以傀代身"
    },
    {
      "id": "gz_xutian_gate",
      "poi_id": "xutian_gate",
      "region_id": "mortal_realm",
      "title": "虚天殿门",
      "text": "殿门半开，寒气与火光在门缝里互相撕咬。门槛上的霜化了又结，像有人反复进出，又像殿本身在呼吸。进去的人分两条道：一条冷得发蓝，一条热得发白。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "冰火双道",
      "related_dungeon": "xutian"
    },
    {
      "id": "gz_kunwu_gate",
      "poi_id": "kunwu_gate",
      "region_id": "mortal_realm",
      "title": "昆吾封魔塔",
      "text": "塔影压过半座山。塔门上的封纹，白天看是暗的，夜里会亮——亮得很有节奏，像在数层数。守塔人早已不在，只余一句口口相传的话：上得去，未必下得来。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "会发亮的封纹",
      "related_dungeon": "kunwu"
    },
    {
      "id": "gz_mulan_camp",
      "poi_id": "mulan_camp",
      "region_id": "mortal_realm",
      "title": "慕兰边营",
      "text": "战线拉长了，补给却总是慢一步。营门的木栅上钉着各色符纸，有的是求平安，有的是记军功。夜里有人擦枪，有人写信，有人只是看着北边的黑。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "战线与补给"
    },
    {
      "id": "gz_huanglong_gate",
      "poi_id": "huanglong_gate",
      "region_id": "mortal_realm",
      "title": "黄龙山口",
      "text": "只有同门能结阵入山——外人看着是雾，自己人看着是路。山风过时，五处阵眼同时轻响，像有人在远处点名。山口的石碑只刻了两个字：同心。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "同门结阵",
      "related_dungeon": "huanglong"
    },
    {
      "id": "gz_yuncheng",
      "poi_id": "yuncheng",
      "region_id": "spirit_realm",
      "title": "云霄城",
      "text": "城在云上，阶在脚下。讨价还价的声音比雷还密。有人卖飞剑残片，有人卖一则不知真假的飞升旧闻。城主从不露面，只在每月十五把最高那盏灯点上。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "云上的生意"
    },
    {
      "id": "gz_xianyuan_sect",
      "poi_id": "xianyuan_sect",
      "region_id": "spirit_realm",
      "title": "仙缘宫",
      "text": "宫门常年闭着。开门的不是人，是时机。阶前的石兽被摸得发亮，都是求缘之人留下的手泽。宫内偶传钟声，一声在天，一声在心。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "时机开门"
    },
    {
      "id": "gz_xianting",
      "poi_id": "xianting",
      "region_id": "celestial_realm",
      "title": "仙庭墟市",
      "text": "仙人也赶集。只是摊上卖的，多半是因果。有人以一段记忆换一粒丹，有人以一句承诺换一条路。秤是准的，人心未必。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "因果集市"
    },
    {
      "id": "gz_hundun_fissure",
      "poi_id": "hundun_fissure",
      "region_id": "celestial_realm",
      "title": "混沌裂隙",
      "text": "裂隙边缘的石头在往里滚。没有人问它们去了哪。靠得太近时，神识会被拉成细丝——有人在此悟道，也有人在此丢了名字。",
      "first_discover_item_key": "gazetteer_scrap",
      "lore_hook": "被吞没的名字"
    }
  ],

