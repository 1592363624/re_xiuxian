{
  "_comment": "大地图格子化总配置。规则参数集中在此，禁止在代码里写魔法数字。设计文档：docs/大地图格子化设计方案.md §7/§15。资源/怪物 id 只引用 resource_data.json 与 map_data.json 已有键。",
  "_version": "1.0.0",
  "_updated": "2026-09-23",

  "grid": {
    "cell_size": 10,
    "default_cell_px": 40,
    "cache_enabled": true,
    "cache_max_entries": 5000
  },

  "interaction": {
    "_comment": "全局交互前提原则（§4.2.1）。require_same_cell 为已定案核心规则，不建议关闭。",
    "require_same_cell": true,
    "require_visible": true,
    "require_state_free": true,
    "exclusive_states": ["cultivating", "in_battle", "moving", "banned"]
  },

  "vision": {
    "_comment": "视野半径 = f(sense 神识属性)，被动生效不扣池。显影/探查走 sensePool，见 grid_poi_data.hidden 与 API /reveal。",
    "base_radius": 3,
    "distance_metric": "chebyshev",
    "sense_tiers": [
      { "sense_min": 0, "radius": 3, "_note": "炼气" },
      { "sense_min": 30, "radius": 4, "_note": "筑基初" },
      { "sense_min": 200, "radius": 5, "_note": "筑基后" },
      { "sense_min": 1000, "radius": 6, "_note": "金丹 · 12×12 新手区到顶" },
      { "sense_min": 3000, "radius": 8, "_note": "元婴" },
      { "sense_min": 8000, "radius": 10, "_note": "化神+" }
    ],
    "snapshot_enabled": true,
    "snapshot_on_visible_only": true,
    "known_cell_retention_days": 90,
    "known_cell_archive_not_delete": true
  },

  "movement": {
    "_comment": "统一移动：耗时(秒) = 距离(格) × cell_seconds。时间本身就是速率限制器，废除 MAX_STEP。",
    "cell_seconds": 1,
    "terrain_multiplier_enabled": false,
    "terrain_multiplier": {
      "plains": 1, "forest": 1, "mountain": 1,
      "ocean": 1, "cave": 1, "ruin": 1, "celestial": 1
    },
    "instant_move_max_cells": 3,
    "max_cells_per_move": 200,
    "move_interval_ms": 1000,
    "path_preview_enabled": true,
    "path_adjacency": 8,
    "path_unknown_as_passable": true,
    "path_avoid_types": ["barrier"],
    "path_mark_types": ["monster_nest", "barrier"],
    "wasteland": {
      "traversable": true,
      "no_interaction": true,
      "no_exploration_progress": true,
      "max_cross_seconds": 600
    },
    "travel_flavor": {
      "_comment": "§13.2 行旅薄内容。长事件间隔 5–8 格。",
      "enchant_min_cells": 10,
      "enchant_interval_cells": [5, 8],
      "trail_bonus": {
        "enabled": false,
        "edge_walk_threshold": 30,
        "speed_multiplier": 0.5,
        "min_cell_seconds": 0.5
      }
    }
  },

  "empty_cell": {
    "_comment": "空格随机事件：定位是路过的安全感，不是值得刷的点。",
    "event_rate": 0.08,
    "preferred_types": ["peaceful", "discovery"]
  },

  "build": {
    "allowed_terrain": ["mountain", "cave", "forest"],
    "unique_per_cell": true,
    "abandon_days_threshold": 30,
    "legacy_auto_open": true,
    "shrink_refund_rate": 0.5,
    "cost_spirit_stones": 1000,
    "visit_policy_default": "need_approval",
    "settlement": {
      "_comment": "§13.7 聚落：半径内他人洞府计数，上限 3 级。",
      "radius": 2,
      "max_level": 3,
      "level_thresholds": [1, 3, 5],
      "names_pool_key": "settlement_names"
    }
  },

  "reveal": {
    "_comment": "§13.3 显影/探查：扣神识池，不扣属性。属性只影响成功率。",
    "reveal_window_seconds": 12,
    "reveal_radius_bonus": 2,
    "reveal_sense_cost": 30,
    "probe_sense_cost": 20,
    "probe_seconds": 5,
    "probe_cooldown_seconds": 60,
    "probe_success_base": 0.45,
    "probe_success_per_sense": 0.00005,
    "probe_success_cap": 0.9
  },

  "gazetteer": {
    "_comment": "§13.8/Q16：单条只给残卷收集物；集齐一区给称号 + sense_bonus。",
    "set_bonus_sense": {
      "yueguo": 20,
      "luanxing_sea": 40,
      "dayan_hall": 60,
      "mortal_realm": 80,
      "spirit_realm": 100,
      "celestial_realm": 150
