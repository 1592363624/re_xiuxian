{
  "_comment": "系统任务「尘缘指归」静态内容。一条独立线性链，三卷：识途（教程）/ 立心（入门主线）/ 破障（进阶机制）。完成当前环自动发奖并自动接到下一环；老号打开面板时按 state/metric 追认快进。环名与正文必须有修仙语汇与机制教学，禁止「再做 N 次」换皮。",
  "chain": {
    "id": "zhigui",
    "name": "尘缘指归",
    "short_name": "指归",
    "intro": "识海微震，多了一枚无名玉简。页首只有一句——「尘缘未了，指归在此。」它不拜师承，只在你该走下一步时，浮出一行小字。",
    "ending": "玉简无风自燃，碎作漫天星屑。页末最后一行小字慢慢浮起：「指路人到此为止。往后的路，你自己写。」",
    "final_title_id": "zhigui_returned"
  },
  "acts": [
    {
      "id": 1,
      "name": "识途",
      "subtitle": "学会基本操作",
      "epilogue": "玉简合上一页，墨迹未干：「你已不是站着挨打的凡人。」"
    },
    {
      "id": 2,
      "name": "立心",
      "subtitle": "接到核心目标",
      "epilogue": "「修仙主循环你已见过——修为、人事、资源、破关。去争长生。」"
    },
    {
      "id": 3,
      "name": "破障",
      "subtitle": "引入新机制",
      "epilogue": "「易被忽略的门，你都推开过一扇。再往后，看你的缘法。」"
    }
  ],
