# AI 大模型配置
# 在这里配置你的 AI API Key

# 小米 MiMo API Key（推荐！免费额度充足）
# 获取地址: https://platform.xiaomimimo.com/
# AI_API_KEY=your_xiaomi_mimo_api_key_here
# AI_PROVIDER=xiaomi目前
# AI_MODEL=mimo-v2-flash
# AI_BASE_URL=https://api.xiaomimimo.com/v1

# OpenAI API Key（备选）
# AI_API_KEY=your_openai_api_key_here
# AI_PROVIDER=openai
# AI_MODEL=gpt-3.5-turbo
# AI_BASE_URL=https://api.openai.com/v1

# 通义千问 API Key（备选）
# AI_API_KEY=your_qwen_api_key_here
# AI_PROVIDER=qwen
# AI_MODEL=qwen-turbo
# AI_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 数据库配置
DB_HOST=your_db_host_here
DB_PORT=3306
DB_NAME=your_db_name_here
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here

# 服务器配置
PORT=5000
NODE_ENV=development

# JWT 密钥
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# QQ 互联登录（在 https://connect.qq.com 创建"网站应用"后获取）
# 三项齐备才会启用 QQ 登录，缺任意一项前端不显示入口、后端拒绝发起授权。
# 硬性前提：回调地址的域名必须已在 QQ 互联后台通过备案校验，否则 QQ 会直接拒绝授权跳转。
QQ_APP_ID=your_qq_app_id_here
QQ_APP_KEY=your_qq_app_key_here
# 必须与 QQ 互联后台填写的回调地址逐字符一致（协议、域名、端口、路径都算）
QQ_REDIRECT_URI=https://your-domain.com/api/auth/qq/callback
# 可选：仅当前端与后端不在同一域名（且无网关代理 /api）时才需配置为前端站点根地址，
# 留空则回调后按相对路径 302 回当前 origin 的根目录
# QQ_FRONTEND_URL=https://your-domain.com

# AI 配置加密密钥（用于 GM 后台存储 AI API Key 的 AES-256-CBC 加密）
# 必须为 64 位十六进制字符串（32 字节），生产环境请使用强随机密钥
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_CONFIG_ENCRYPTION_KEY=replace_with_your_64_hex_chars_key_32_bytes_random
